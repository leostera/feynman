{
  "summary": "Create a Workspace for a project directory together with its first Pi-backed session.",
  "trigger": "axo.workspace.create {name, directoryPath, directoryBookmark?}",
  "steps": [
    {
      "actor": "axod",
      "action": "validate name and require an absolute directory path",
      "protocol": "local-rpc"
    },
    {
      "actor": "axod",
      "action": "open the directory with normal permissions, or resolve the security-scoped bookmark"
    },
    {
      "actor": "axod",
      "action": "insert Workspace row (state open)"
    },
    {
      "actor": "axod",
      "action": "create the first Workspace session",
      "ref": "create-workspace-session"
    },
    {
      "actor": "axod",
      "action": "on session failure, mark the Workspace archived",
      "properties": [
        "compensating write, not a transaction"
      ]
    },
    {
      "actor": "axod",
      "action": "hold directory access for as long as the Workspace is open"
    },
    {
      "actor": "axod",
      "action": "start the Pi bridge worker",
      "ref": "pi-bridge"
    },
    {
      "actor": "axod",
      "action": "publish session.snapshot and workspace.changed"
    }
  ],
  "anchors": [
    "crates/axo-server/src/session.rs#create_workspace",
    "crates/axo-server/src/workspace_access.rs"
  ]
}
