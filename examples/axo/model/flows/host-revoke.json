{
  "summary": "An account owner unlinks a host.",
  "trigger": "POST /api/v1/account/hosts/:host/revoke",
  "steps": [
    {
      "actor": "account-do",
      "action": "set revoked_at on the host"
    },
    {
      "actor": "account-do",
      "action": "close the host's relay socket; future connections fail authorization"
    },
    {
      "actor": "account-do",
      "action": "retain last-known metadata as offline"
    }
  ],
  "anchors": [
    "packages/axo-api-worker/src/auth/account-manager.ts#revokeHost",
    "packages/axo-api-worker/src/http/account-hosts.ts"
  ]
}
