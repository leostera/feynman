      "actor": "ghostty-kit",
      "action": "Duplicate the descriptors, parse replay/live output, and send terminal input and later resizes to the adopted PTY without spawning a subprocess.",
      "protocol": "terminal-attachment"
    },
    {
      "actor": "ghostty-kit",
      "action": "On external output EOF, report a child-exit notification to the surface while leaving actual shell lifecycle to Axo/axod."
