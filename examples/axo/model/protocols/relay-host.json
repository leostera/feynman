{
  "summary": "The relay between linked hosts and browser clients, through the account's Durable Object.",
  "style": "json-rpc",
  "transport": "WebSocket (WSS), outbound from axod; browser clients connect to the same Durable Object",
  "server": "account-do",
  "clients": [
    "axod",
    "web-app"
  ],
  "framing": "JSON-RPC 2.0 in text frames ≤65,536 bytes; ≤8 calls per batch; every received frame is acknowledged with axo.transport.ack.",
  "version": "1",
  "messages": [
    {
      "name": "axo.host.register",
      "kind": "call",
      "from": "axod",
      "summary": "Renews the route lease (30 s).",
      "fields": [
        {
          "name": "protocolVersion",
          "type": "1"
        },
        {
          "name": "hostId",
          "type": "uuid"
        },
        {
          "name": "hostGeneration",
          "type": "uuid",
          "note": "new per daemon boot"
        },
        {
          "name": "label",
          "type": "string",
          "note": "1 to 128 chars"
        },
        {
          "name": "hostKind",
          "type": "string"
        },
        {
          "name": "capabilities",
          "type": "HostCapabilities",
          "required": false
        },
        {
          "name": "sessions",
          "type": "SessionSnapshot[]",
          "note": "≤256; Pi panes and paths removed"
        }
      ]
    },
    {
      "name": "axo.host.heartbeat",
      "kind": "call",
      "from": "axod",
      "summary": "Every 10 s.",
      "fields": [
        {
          "name": "hostId",
          "type": "uuid"
        },
        {
          "name": "hostGeneration",
          "type": "uuid"
        }
      ]
    },
    {
      "name": "axo.host.sessions.publish",
      "kind": "call",
      "from": "axod",
      "fields": [
        {
          "name": "hostId",
          "type": "uuid"
        },
        {
          "name": "hostGeneration",
          "type": "uuid"
        },
        {
          "name": "sessions",
          "type": "SessionSnapshot[]",
          "note": "≤256"
        }
      ]
    },
    {
      "name": "host event",
      "kind": "event",
      "from": "axod",
      "summary": "Local events forwarded by the relay loop; on lag, current snapshots are resent.",
      "fields": [
        {
          "name": "hostId",
          "type": "uuid"
        },
        {
          "name": "hostGeneration",
          "type": "uuid"
        },
        {
          "name": "event",
          "type": "session.snapshot | session.removed | shell.activity | terminal.output | pi.event"
        }
      ]
    },
    {
      "name": "axo.host.list",
      "kind": "call",
      "from": "web-app",
      "fields": []
    },
    {
      "name": "axo.host.sessions.list",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "hostId",
          "type": "uuid"
        },
        {
          "name": "hostGeneration",
          "type": "uuid"
        }
      ]
    },
    {
      "name": "axo.host.subscribe",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "hostId",
          "type": "uuid"
        },
        {
          "name": "hostGeneration",
          "type": "uuid"
        }
      ]
    },
    {
      "name": "axo.host.unsubscribe",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "uuid"
        }
      ]
    },
    {
      "name": "axo.remote.session.create",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        }
      ]
    },
    {
      "name": "axo.remote.workspace.session.create",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        },
        {
          "name": "workspaceId",
          "type": "uuid"
        }
      ]
    },
    {
      "name": "axo.remote.session.close",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        },
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        }
      ]
    },
    {
      "name": "axo.remote.shell.create",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        },
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        }
      ]
    },
    {
      "name": "axo.remote.shell.close",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        },
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        }
      ]
    },
    {
      "name": "axo.remote.session.layout.set",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        },
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "layout",
          "type": "LayoutNode"
        }
      ]
    },
    {
      "name": "axo.remote.terminal.input",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        },
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        },
        {
          "name": "sequence",
          "type": "integer",
          "note": "0 to 2^53−1"
        },
        {
          "name": "data",
          "type": "base64",
          "note": "4 to 65,536 chars"
        }
      ]
    },
    {
      "name": "axo.remote.terminal.resize",
      "kind": "call",
      "from": "web-app",
      "fields": [
        {
          "name": "target",
          "type": "{ hostId, hostGeneration }",
          "note": "host reference"
        },
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        },
        {
          "name": "rows",
          "type": "integer",
          "note": "1 to 65,535"
        },
        {
          "name": "columns",
          "type": "integer",
          "note": "1 to 65,535"
        }
      ]
    }
  ],
  "parsing": [
    {
      "summary": "Every call and reply is parsed with zod schemas from @axo/protocol before routing; frames over 64 KiB are rejected.",
      "anchors": [
        "packages/axo-api/src/v1.ts",
        "packages/axo-api/src/contracts.ts",
        "packages/axo-api-worker/src/axo-host-relay.ts#webSocketMessage"
      ]
    }
  ],
  "definitions": [
    "schemas/axo.leostera.dev/v1/host-relay.schema.json",
    "packages/axo-api/src/v1.ts"
  ],
  "anchors": [
    "crates/axo-relay/src/relay.rs",
    "packages/axo-api-worker/src/axo-host-relay.ts",
    "packages/axo-api/src/v1.ts"
  ]
}
