{
  "summary": "Local Axo control and event API between app/client and axod.",
  "style": "json-rpc",
  "transport": "Unix-domain socket at ~/Library/Application Support/Axo/run/axod.sock (override supported), mode 0600; per-user state defaults to ~/.axo/server.",
  "server": "axod-daemon",
  "clients": [
    "axo-macos-app",
    "axod-cli"
  ],
  "framing": "JSON-RPC 2.0 requests and responses are newline-delimited UTF-8; request line maximum 8 MiB, 64 requests in flight per connection. Concurrent responses may be out of order and correlate by JSON-RPC id.",
  "version": "axo.protocol.negotiate version 1; clients receive advertised method names, no other version is defined.",
  "messages": [
    {
      "name": "axo.protocol.negotiate",
      "kind": "call",
      "fields": [
        {
          "name": "protocolVersion",
          "type": "u32"
        }
      ],
      "returns": [
        {
          "name": "protocolVersion",
          "type": "u32"
        },
        {
          "name": "methods",
          "type": "string[]"
        }
      ],
      "summary": "Rejects unsupported protocol versions and returns the supported method list."
    },
    {
      "name": "axo.daemon.health",
      "kind": "call",
      "returns": [
        {
          "name": "version",
          "type": "string"
        },
        {
          "name": "buildNumber",
          "type": "u64"
        },
        {
          "name": "status",
          "type": "running"
        }
      ]
    },
    {
      "name": "axo.session.list",
      "kind": "call",
      "returns": [
        {
          "name": "sessions",
          "type": "SessionRecord[]"
        },
        {
          "name": "resumeSessionId",
          "type": "SessionId|null"
        }
      ]
    },
    {
      "name": "axo.session.events.next",
      "kind": "call",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string"
        },
        {
          "name": "timeoutMs",
          "type": "u64",
          "note": "1..=20000"
        },
        {
          "name": "maxEvents",
          "type": "usize",
          "required": false,
          "note": "1..=256; absent selects the legacy single-event result"
        }
      ],
      "returns": [
        {
          "name": "event or events",
          "type": "Event|null | Event[]",
          "note": "Empty when poll times out; single-event or batch shape follows maxEvents presence."
        }
      ]
    },
    {
      "name": "axo.terminal.input",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId"
        },
        {
          "name": "shellId",
          "type": "ShellId"
        },
        {
          "name": "sequence",
          "type": "u64",
          "note": "Per-shell sequence starts at zero; repeated sequence is acknowledged and ignored."
        },
        {
          "name": "data",
          "type": "base64 string",
          "note": "Decodes to 1..=49152 bytes."
        }
      ],
      "returns": [
        {
          "name": "accepted",
          "type": "bool"
        },
        {
          "name": "sequence",
          "type": "u64"
        }
      ]
    },
    {
      "name": "axo.terminal.resize",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId"
        },
        {
          "name": "shellId",
          "type": "ShellId"
        },
        {
          "name": "rows",
          "type": "u32"
        },
        {
          "name": "columns",
          "type": "u32"
        }
      ],
      "returns": [
        {
          "name": "accepted",
          "type": "bool"
        },
        {
          "name": "rows",
          "type": "u32"
        },
        {
          "name": "columns",
          "type": "u32"
        }
      ]
    },
    {
      "name": "axo.session.event notification",
      "kind": "event",
      "summary": "Subscription-scoped notifications encode session.snapshot, session.removed, shell.activity, terminal.output, workspace.changed, session.focus, relay.status, or subscription.lagged; lag requires a new snapshot/list resynchronization."
    },
    {
      "name": "terminal.output",
      "kind": "event",
      "summary": "Base64 terminal output with per-shell sequence is streamed to subscribed clients that include streams; not a catalog event."
    },
    {
      "name": "axo.session.create / close; axo.shell.create / close; axo.session.layout.set",
      "kind": "call",
      "summary": "Create/close session and pane records and update validated session layout; close of final session creates a replacement."
    },
    {
      "name": "axo.workspace.*",
      "kind": "call",
      "summary": "List, create, rename, archive workspaces and create a session within a workspace."
    },
    {
      "name": "axo.relay.*",
      "kind": "call",
      "summary": "Read/configure/disable remote access, link host, read status, and request a connection."
    }
  ],
  "parsing": [
    {
      "summary": "Typed method parameters deserialize from JSON before handlers execute; structs reject unknown fields, malformed values receive InvalidParams, while layout, terminal dimensions/input sequence and bounds are checked by handlers.",
      "anchors": [
        "crates/axo-ipc/src/server.rs#parse_params",
        "crates/axo-protocol/src/rpc.rs"
      ]
    }
  ],
  "definitions": [
    "crates/axo-protocol/src/rpc.rs",
    "schemas/axo.leostera.dev/v1/local-rpc.schema.json"
  ],
