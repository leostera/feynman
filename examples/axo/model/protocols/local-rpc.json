{
  "summary": "axod's local control API. Clients call methods to manage Workspaces, Sessions, panes and the relay, and long-poll for events.",
  "style": "json-rpc",
  "transport": "Unix-domain socket",
  "server": "axod",
  "clients": [
    "axo-mac"
  ],
  "framing": "Newline-delimited JSON-RPC 2.0. Requests ≤8 MiB; ≤64 in flight per connection. Parameters reject unknown fields.",
  "version": "1, negotiated with axo.protocol.negotiate",
  "messages": [
    {
      "name": "axo.protocol.negotiate",
      "kind": "call",
      "fields": [
        {
          "name": "protocolVersion",
          "type": "u32",
          "note": "must be 1"
        }
      ],
      "returns": [
        {
          "name": "protocolVersion",
          "type": "u32"
        },
        {
          "name": "methods",
          "type": "string[]",
          "note": "every advertised method"
        }
      ]
    },
    {
      "name": "axo.daemon.health",
      "kind": "call",
      "fields": [],
      "returns": [
        {
          "name": "version",
          "type": "string"
        },
        {
          "name": "buildNumber",
          "type": "u64"
        },
        {
          "name": "status",
          "type": "\"running\""
        }
      ]
    },
    {
      "name": "axo.config.get",
      "kind": "call",
      "fields": [
        {
          "name": "key",
          "type": "\"agent.command\" | \"shell.command\""
        }
      ],
      "returns": [
        {
          "name": "key",
          "type": "ConfigKey"
        },
        {
          "name": "value",
          "type": "string"
        }
      ]
    },
    {
      "name": "axo.config.set",
      "kind": "call",
      "summary": "Applies to panes launched afterwards.",
      "fields": [
        {
          "name": "key",
          "type": "\"agent.command\" | \"shell.command\""
        },
        {
          "name": "value",
          "type": "string",
          "note": "command line, shell-style quoting"
        }
      ],
      "returns": [
        {
          "name": "key",
          "type": "ConfigKey"
        },
        {
          "name": "value",
          "type": "string"
        }
      ]
    },
    {
      "name": "axo.session.list",
      "kind": "call",
      "fields": [],
      "returns": [
        {
          "name": "sessions",
          "type": "SessionRecord[]"
        },
        {
          "name": "resumeSessionId",
          "type": "SessionId",
          "required": false,
          "note": "set once after Pi's /resume"
        }
      ]
    },
    {
      "name": "axo.session.create",
      "kind": "call",
      "summary": "Standalone terminal session rooted at $HOME.",
      "fields": [],
      "returns": [
        {
          "name": "(result)",
          "type": "SessionRecord",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.session.close",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        }
      ],
      "returns": [
        {
          "name": "archivedSessionId",
          "type": "SessionId"
        },
        {
          "name": "replacement",
          "type": "SessionRecord",
          "required": false,
          "note": "created when this was the last of its kind"
        }
      ]
    },
    {
      "name": "axo.session.rename",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "name",
          "type": "string"
        }
      ],
      "returns": [
        {
          "name": "(result)",
          "type": "SessionRecord",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.session.layout.set",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "layout",
          "type": "LayoutNode",
          "note": "binary split tree, ≤64 deep, ≤255 nodes"
        }
      ],
      "returns": [
        {
          "name": "saved",
          "type": "true"
        }
      ]
    },
    {
      "name": "axo.session.pi.restart.auto.v1",
      "kind": "call",
      "summary": "Recover an unavailable Pi pane without forcing a running Pi to stop.",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        }
      ],
      "returns": [
        {
          "name": "(result)",
          "type": "SessionRecord",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.session.pi.restart.force.v2",
      "kind": "call",
      "summary": "Explicit user restart; may signal the verified Pi process group.",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        }
      ],
      "returns": [
        {
          "name": "(result)",
          "type": "SessionRecord",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.session.subscribe",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "required": false,
          "note": "only this session; all when absent"
        },
        {
          "name": "includeTerminalOutput",
          "type": "boolean",
          "required": false,
          "note": "default true; catalog clients pass false"
        }
      ],
      "returns": [
        {
          "name": "subscriptionId",
          "type": "string"
        }
      ]
    },
    {
      "name": "axo.session.events.next",
      "kind": "call",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string"
        },
        {
          "name": "timeoutMs",
          "type": "u64",
          "note": "1 to 20,000"
        },
        {
          "name": "maxEvents",
          "type": "usize",
          "required": false,
          "note": "1 to 256; a single event when absent"
        }
      ],
      "returns": [
        {
          "name": "events | event",
          "type": "Event[] | Event?",
          "note": "empty when the wait timed out"
        }
      ]
    },
    {
      "name": "axo.session.unsubscribe",
      "kind": "call",
      "fields": [
        {
          "name": "subscriptionId",
          "type": "string"
        }
      ],
      "returns": [
        {
          "name": "unsubscribed",
          "type": "true"
        }
      ]
    },
    {
      "name": "axo.workspace.list",
      "kind": "call",
      "fields": [],
      "returns": [
        {
          "name": "workspaces",
          "type": "WorkspaceRecord[]"
        }
      ]
    },
    {
      "name": "axo.workspace.create",
      "kind": "call",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "note": "1 to 80 chars, no control characters"
        },
        {
          "name": "directoryPath",
          "type": "path",
          "note": "absolute"
        },
        {
          "name": "directoryBookmark",
          "type": "base64",
          "required": false,
          "note": "macOS security-scoped bookmark"
        }
      ],
      "returns": [
        {
          "name": "workspace",
          "type": "WorkspaceRecord"
        },
        {
          "name": "session",
          "type": "SessionRecord"
        }
      ]
    },
    {
      "name": "axo.workspace.rename",
      "kind": "call",
      "fields": [
        {
          "name": "workspaceId",
          "type": "uuid"
        },
        {
          "name": "name",
          "type": "string"
        }
      ],
      "returns": [
        {
          "name": "(result)",
          "type": "WorkspaceRecord",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.workspace.archive",
      "kind": "call",
      "fields": [
        {
          "name": "workspaceId",
          "type": "uuid"
        }
      ],
      "returns": [
        {
          "name": "archivedWorkspaceId",
          "type": "uuid"
        },
        {
          "name": "archivedSessionIds",
          "type": "SessionId[]"
        }
      ]
    },
    {
      "name": "axo.workspace.session.create",
      "kind": "call",
      "fields": [
        {
          "name": "workspaceId",
          "type": "uuid"
        }
      ],
      "returns": [
        {
          "name": "(result)",
          "type": "SessionRecord",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.shell.create",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        }
      ],
      "returns": [
        {
          "name": "(result)",
          "type": "ShellRecord",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.shell.close",
      "kind": "call",
      "summary": "Closing a Pi pane or a session's last pane closes the session.",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        }
      ],
      "returns": [
        {
          "name": "archivedShellId",
          "type": "ShellId"
        },
        {
          "name": "archivedSessionId",
          "type": "SessionId",
          "required": false,
          "note": "set when the session closed too"
        },
        {
          "name": "replacement",
          "type": "SessionRecord",
          "required": false
        }
      ]
    },
    {
      "name": "axo.shell.busy",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        }
      ],
      "returns": [
        {
          "name": "busy",
          "type": "boolean",
          "note": "foreground job, or a Pi turn in progress"
        },
        {
          "name": "foregroundProcess",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "axo.terminal.input",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        },
        {
          "name": "sequence",
          "type": "u64",
          "note": "per shell from 0, consecutive; repeats are ignored"
        },
        {
          "name": "data",
          "type": "base64",
          "note": "1 to 49,152 bytes decoded"
        }
      ],
      "returns": [
        {
          "name": "accepted",
          "type": "true"
        },
        {
          "name": "sequence",
          "type": "u64"
        }
      ]
    },
    {
      "name": "axo.terminal.resize",
      "kind": "call",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        },
        {
          "name": "rows",
          "type": "u32"
        },
        {
          "name": "columns",
          "type": "u32"
        }
      ],
      "returns": [
        {
          "name": "accepted",
          "type": "true"
        },
        {
          "name": "rows",
          "type": "u32"
        },
        {
          "name": "columns",
          "type": "u32"
        }
      ]
    },
    {
      "name": "axo.client.viewport.set",
      "kind": "call",
      "summary": "Lets axod size new panes before any client shows them.",
      "fields": [
        {
          "name": "viewport",
          "type": "Viewport",
          "note": "area, backing scale, cell size, padding, divider; all bounded"
        }
      ],
      "returns": [
        {
          "name": "accepted",
          "type": "true"
        }
      ]
    },
    {
      "name": "axo.relay.settings",
      "kind": "call",
      "fields": [],
      "returns": [
        {
          "name": "enabled",
          "type": "boolean"
        },
        {
          "name": "relayUrl",
          "type": "string",
          "required": false
        },
        {
          "name": "hostLabel",
          "type": "string",
          "required": false
        },
        {
          "name": "hostKind",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "axo.relay.configure",
      "kind": "call",
      "fields": [
        {
          "name": "relayUrl",
          "type": "url"
        },
        {
          "name": "hostLabel",
          "type": "string"
        },
        {
          "name": "hostKind",
          "type": "string"
        }
      ],
      "returns": [
        {
          "name": "(result)",
          "type": "RelaySettings",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.relay.link",
      "kind": "call",
      "fields": [
        {
          "name": "code",
          "type": "string",
          "note": "XXXX-YYYY pairing code"
        }
      ],
      "returns": [
        {
          "name": "linked",
          "type": "true"
        },
        {
          "name": "hostLabel",
          "type": "string"
        }
      ]
    },
    {
      "name": "axo.relay.disable",
      "kind": "call",
      "fields": [],
      "returns": [
        {
          "name": "disabled",
          "type": "true"
        }
      ]
    },
    {
      "name": "axo.relay.status",
      "kind": "call",
      "fields": [],
      "returns": [
        {
          "name": "(result)",
          "type": "RelayStatus",
          "note": "returned directly"
        }
      ]
    },
    {
      "name": "axo.relay.connect",
      "kind": "call",
      "fields": [],
      "returns": [
        {
          "name": "requested",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "session.snapshot",
      "kind": "event",
      "from": "axod",
      "fields": [
        {
          "name": "session",
          "type": "SessionRecord",
          "note": "replaces any earlier snapshot"
        }
      ]
    },
    {
      "name": "session.removed",
      "kind": "event",
      "from": "axod",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        }
      ]
    },
    {
      "name": "session.focus",
      "kind": "event",
      "from": "axod",
      "summary": "Clients should select this session (after Pi's /resume).",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        }
      ]
    },
    {
      "name": "shell.activity",
      "kind": "event",
      "from": "axod",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        },
        {
          "name": "activity",
          "type": "\"started\" | \"exited\" | \"attached\" | \"detached\""
        }
      ]
    },
    {
      "name": "terminal.output",
      "kind": "event",
      "from": "axod",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "shellId",
          "type": "ShellId",
          "note": "positive integer"
        },
        {
          "name": "sequence",
          "type": "u64",
          "note": "chunks per shell from 0"
        },
        {
          "name": "data",
          "type": "base64"
        }
      ]
    },
    {
      "name": "pi.event",
      "kind": "event",
      "from": "axod",
      "fields": [
        {
          "name": "sessionId",
          "type": "SessionId",
          "note": "positive integer"
        },
        {
          "name": "piSessionId",
          "type": "string"
        },
        {
          "name": "streamId",
          "type": "string"
        },
        {
          "name": "sequence",
          "type": "u64"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "data",
          "type": "JSON",
          "note": "Pi's payload, opaque to axod"
        }
      ]
    },
    {
      "name": "workspace.changed",
      "kind": "event",
      "from": "axod",
      "fields": [
        {
          "name": "workspaceId",
          "type": "uuid"
        }
      ]
    },
    {
      "name": "relay.status",
      "kind": "event",
      "from": "axod",
      "fields": [
        {
          "name": "status",
          "type": "RelayStatus"
        }
      ]
    },
    {
      "name": "subscription.lagged",
      "kind": "event",
      "from": "axod",
      "summary": "The queue overflowed and events were dropped; resynchronize from a fresh list.",
      "fields": []
    }
  ],
  "parsing": [
    {
      "summary": "Params deserialize into typed structs that reject unknown fields and invalid IDs before any handler runs.",
      "anchors": [
        "crates/axo-protocol/src/rpc.rs",
        "crates/axo-ipc/src/server.rs#parse_params"
      ]
    },
    {
      "summary": "Workspace name and absolute path are validated, and the directory opened, before any row is written.",
      "anchors": [
        "crates/axo-server/src/session.rs#create_workspace",
        "crates/axo-server/src/workspace_access.rs"
      ]
    },
    {
      "summary": "Layouts arrive structurally typed; the handler checks depth, size and pane membership before persisting.",
      "anchors": [
        "crates/axo-protocol/src/layout.rs",
        "crates/axo-server/src/session.rs#set_layout"
      ]
    },
    {
      "summary": "Terminal input is base64-decoded and size-checked before the PTY write.",
      "anchors": [
        "crates/axo-server/src/session.rs#write_terminal_input"
      ]
    },
    {
      "summary": "Configured commands are parsed with shell-style quoting (no shell invoked), ≤4096 bytes and ≤128 arguments; managed Pi flags are rejected.",
      "anchors": [
        "crates/axo-pty/src/command.rs",
        "crates/axo-pi/src/command.rs"
      ]
    },
    {
      "summary": "The client viewport is bounded (area, scale, cell size, padding, ratios) before grid sizes are computed.",
      "anchors": [
        "crates/axo-protocol/src/viewport.rs"
      ]
    }
  ],
  "definitions": [
    "schemas/axo.leostera.dev/v1/local-rpc.schema.json",
    "schemas/axo.leostera.dev/v1/events.schema.json",
    "schemas/axo.leostera.dev/v1/common.schema.json",
    "crates/axo-protocol/src/conformance.rs"
  ],
  "compatibility": "Single protocol version. Behaviour changes ship as new method names (…restart.force.v2, …restart.auto.v1).",
  "anchors": [
    "crates/axo-protocol/src/rpc.rs",
    "crates/axo-protocol/src/event.rs",
    "crates/axo-server/src/lib.rs",
    "crates/axo-server/src/session.rs#register_rpc_methods",
    "apple/AxoRPC/Sources/AxoRPC/UnixSocketRPC.swift"
  ]
}
