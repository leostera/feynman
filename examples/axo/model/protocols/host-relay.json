{
  "summary": "Versioned host API and remote-operation messages multiplexed through authenticated WebSockets and the AxoHostRelay Durable Object.",
  "style": "websocket",
  "transport": "HTTPS WebSocket upgrade through Worker routes /v1/hosts/:host/:role and account-scoped relay routes; the Durable Object pairs daemon and client peers for a host.",
  "server": "axo-cloud-api",
  "clients": [
    "axo-macos-app",
    "axod-daemon"
  ],
  "framing": "JSON-RPC 2.0 text frames, optionally batches of at most 8 calls. Frame maximum 65,536 bytes; strict calls/replies parsed with Zod. Per-peer 30 calls per rolling second; peer schema tracks negotiated state, bounded delivery window and host subscriptions. Pending operation and outbound delivery queues are bounded; oversized reply groups preserve each request ID and batch shape while converting outcomes to reconciliation-required errors.",
  "version": "Protocol version 1 negotiated before non-negotiate methods; daemon registration pins host generation and lease.",
  "messages": [
    {
      "name": "axo.protocol.negotiate",
      "kind": "call",
      "fields": [
        {
          "name": "protocolVersion",
          "type": "1"
        }
      ],
      "returns": [
        {
          "name": "protocolVersion",
          "type": "1"
        },
        {
          "name": "methods",
          "type": "string[]"
        },
        {
          "name": "deliveryCredits",
          "type": "{frames:32,bytes:131072}"
        }
      ]
    },
    {
      "name": "axo.host.register",
      "kind": "call",
      "summary": "Daemon registers host ID, generation, label, kind, capabilities and initial session snapshot; returns host metadata."
    },
    {
      "name": "axo.host.heartbeat / axo.host.sessions.publish",
      "kind": "call",
      "summary": "Renews an admitted daemon lease and publishes current session snapshots."
    },
    {
      "name": "axo.host.subscribe / axo.host.unsubscribe",
      "kind": "call",
      "summary": "Client establishes or removes a host-generation-scoped event subscription."
    },
    {
      "name": "axo.host.event",
      "kind": "event",
      "from": "axod-daemon",
      "summary": "Daemon-originated host.data wraps session snapshots/removals, shell activity, base64 terminal.output and Pi events with host ID and generation; the relay forwards to matching subscribed clients. Terminal bytes are ephemeral, while account Pi events are persisted in session history."
    },
    {
      "name": "axo.host.event notification",
      "kind": "event",
      "summary": "The relay sends subscription-scoped host notifications to subscribed clients; presence changes identify online/offline host generation."
    },
    {
      "name": "axo.remote.session.create / axo.remote.workspace.session.create / axo.remote.session.close",
      "kind": "call",
      "summary": "Client requests session lifecycle operations at the designated host generation."
    },
    {
      "name": "axo.remote.shell.create / axo.remote.shell.close / axo.remote.session.layout.set",
      "kind": "call",
      "summary": "Client changes remote shell catalog and layout."
    },
    {
      "name": "axo.remote.terminal.input",
      "kind": "call",
      "fields": [
        {
          "name": "target",
          "type": "HostRef"
        },
        {
          "name": "sessionId",
          "type": "SessionId"
        },
        {
          "name": "shellId",
          "type": "ShellId"
        },
        {
          "name": "sequence",
          "type": "safe integer"
        },
        {
          "name": "data",
          "type": "base64 string",
          "note": "schema length 4..65536"
        }
      ],
      "returns": [
        {
          "name": "accepted",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "axo.remote.terminal.resize",
      "kind": "call",
      "fields": [
        {
          "name": "target",
          "type": "HostRef"
        },
        {
          "name": "sessionId",
          "type": "SessionId"
        },
        {
          "name": "shellId",
          "type": "ShellId"
        },
        {
          "name": "rows",
          "type": "integer 1..65535"
        },
        {
          "name": "columns",
          "type": "integer 1..65535"
        }
      ],
      "returns": [
        {
          "name": "accepted",
          "type": "boolean"
        }
      ]
    }
  ],
  "parsing": [
    {
      "summary": "Worker authenticates the principal and validates route role, UUID host, origin, upgrade, lease, peer identity and method parameters; result schemas are checked before metadata replies are returned. Host-targeted requests must match the live route's generation.",
      "anchors": [
        "packages/axo-api-worker/src/http/router.ts",
        "packages/axo-api-worker/src/axo-host-relay.ts",
        "packages/axo-api/src/contracts.ts"
      ]
    }
  ],
  "definitions": [
    "schemas/axo.leostera.dev/v1/host-relay.schema.json",
    "packages/axo-api/src/host-contracts.ts",
    "packages/axo-api/src/contracts.ts"
  ],
  "compatibility": "Host v1 is advertised; legacy machine register/heartbeat methods remain enabled for existing clients. Durable Object schema migration adapts older route/pending tables. A stale generation is fenced and clients must reconcile unknown outcomes.",
  "anchors": [
