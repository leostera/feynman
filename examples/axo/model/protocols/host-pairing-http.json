    "schemas/axo.leostera.dev/v1/fixtures/host-pairing-redeem.call.json": "8e8d49df65f2e25492d5894f4b70b798d5f03fc9",
    "schemas/axo.leostera.dev/v1/fixtures/host-pairing-redeem.result.json": "230a30f1a20909212fe33b65a6011801c176683b",
    "schemas/axo.leostera.dev/v1/pairing.schema.json": "3b41587cf4624d29cff314238744e27c14c67384"
  }
}
