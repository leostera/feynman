{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:feynman:actor",
  "title": "Actor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance",
    "runsOn",
    "summary",
    "anchors"
  ],
  "properties": {
    "provenance": {
      "enum": [
        "first-party",
        "third-party",
        "ambient"
      ],
      "description": "first-party: implemented in this repository. third-party: external software or service the system depends on. ambient: provided by the platform or environment the system runs in (OS services, the user's shell)."
    },
    "runsOn": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the actor executes.",
      "required": [
        "location"
      ],
      "properties": {
        "location": {
          "enum": [
            "local",
            "browser",
            "remote",
            "cloud"
          ],
          "description": "local: the user's machine. browser: a web page. remote: a server or machine the system operates itself. cloud: a managed service."
        },
        "provider": {
          "type": "string",
          "description": "Who runs it, for remote and cloud actors (Cloudflare, AWS, GitHub, …)."
        },
        "platform": {
          "type": "string",
          "description": "The runtime or product: macOS LaunchAgent, Workers, Durable Objects, Node.js, …"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "anchors": {
      "$ref": "urn:feynman:common#/$defs/anchors"
    },
    "confidence": {
      "$ref": "urn:feynman:common#/$defs/confidence"
    },
    "footprint": {
      "$ref": "urn:feynman:common#/$defs/actorFootprint"
    },
    "sources": {
      "$ref": "urn:feynman:common#/$defs/sources"
    }
  },
  "if": {
    "properties": {
      "provenance": {
        "const": "first-party"
      }
    }
  },
  "then": {
    "required": [
      "footprint"
    ]
  }
}
