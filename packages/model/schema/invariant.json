{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:feynman:invariant",
  "title": "Invariant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement",
    "enforcement",
    "enforcedAt",
    "anchors"
  ],
  "properties": {
    "statement": {
      "type": "string"
    },
    "enforcement": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "compile-time",
          "runtime",
          "test-time",
          "documented"
        ]
      },
      "description": "compile-time: types make violations unrepresentable. runtime: code checks or restores it. test-time: tests exercise it. documented: stated in comments or docs only."
    },
    "consequence": {
      "type": "string",
      "description": "What happens if it breaks."
    },
    "enforcedAt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger",
          "frames"
        ],
        "properties": {
          "trigger": {
            "type": "string",
            "description": "What starts the path: daemon start, an RPC method, a timer, a child exiting."
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symbol",
                "anchor"
              ],
              "properties": {
                "symbol": {
                  "type": "string",
                  "description": "Function or method, as named in the source."
                },
                "anchor": {
                  "$ref": "urn:feynman:common#/$defs/anchor"
                },
                "note": {
                  "type": "string",
                  "description": "What this frame contributes to the enforcement."
                }
              }
            },
            "description": "Call path from the entry point to the enforcement point, outermost first."
          }
        }
      },
      "description": "Code paths that establish or check the invariant. Empty for documented-only invariants."
    },
    "tests": {
      "$ref": "urn:feynman:common#/$defs/anchors",
      "description": "Tests that exercise it."
    },
    "anchors": {
      "$ref": "urn:feynman:common#/$defs/anchors"
    }
  }
}
