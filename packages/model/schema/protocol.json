{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:feynman:protocol",
  "title": "Protocol",
  "type": "object",
  "additionalProperties": false,
  "description": "model/protocols/<id>.json: a shape data must have to cross into, out of, or rest inside the system: wire protocols, APIs, file formats, database schemas.",
  "required": [
    "summary",
    "style",
    "transport",
    "messages",
    "anchors"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "style": {
      "enum": [
        "json-rpc",
        "ndjson",
        "binary",
        "http",
        "websocket",
        "grpc",
        "graphql",
        "database",
        "file",
        "cli",
        "stdio",
        "in-process",
        "local-storage"
      ],
      "description": "Encoding family. database, file, and local-storage describe persisted formats; cli is a command line (arguments, output, exit status); stdio is messages over a child process's standard input and output; in-process is an API between a host program and code it loads (plugin hooks, registered tools and commands)."
    },
    "transport": {
      "type": "string",
      "description": "Socket, URL, or file location, with permissions where relevant."
    },
    "server": {
      "$ref": "urn:feynman:common#/$defs/ref",
      "description": "The actor that serves, owns, or writes it."
    },
    "clients": {
      "$ref": "urn:feynman:common#/$defs/refs"
    },
    "framing": {
      "type": "string",
      "description": "Message boundaries, size limits, concurrency."
    },
    "version": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Method, record type, route, or table name."
          },
          "kind": {
            "enum": [
              "call",
              "record",
              "event",
              "route",
              "table"
            ],
            "description": "call: request with a reply. record: one message in a stream. event: pushed notification. route: HTTP method and path. table: persisted rows."
          },
          "from": {
            "$ref": "urn:feynman:common#/$defs/ref",
            "description": "Sender, when not the protocol's client."
          },
          "summary": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "description": "Type as it reads in the source or wire format, e.g. `u64`, `uuid`, `SessionRecord[]`, `\"open\" | \"archived\"`."
                },
                "required": {
                  "type": "boolean",
                  "description": "Defaults to true."
                },
                "note": {
                  "type": "string",
                  "description": "Bounds, encodings, and meaning."
                }
              }
            },
            "description": "Parameters, record fields, or columns."
          },
          "returns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "description": "Type as it reads in the source or wire format, e.g. `u64`, `uuid`, `SessionRecord[]`, `\"open\" | \"archived\"`."
                },
                "required": {
                  "type": "boolean",
                  "description": "Defaults to true."
                },
                "note": {
                  "type": "string",
                  "description": "Bounds, encodings, and meaning."
                }
              }
            },
            "description": "Result fields of a call."
          }
        }
      }
    },
    "parsing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "anchors"
        ],
        "properties": {
          "summary": {
            "type": "string"
          },
          "anchors": {
            "$ref": "urn:feynman:common#/$defs/anchors"
          }
        }
      },
      "description": "Where untrusted input becomes trusted values, and what is checked."
    },
    "definitions": {
      "$ref": "urn:feynman:common#/$defs/anchors",
      "description": "Machine-readable definitions in the repository (JSON Schema, OpenAPI, zod, protobuf)."
    },
    "compatibility": {
      "type": "string",
      "description": "How versions and legacy shapes coexist."
    },
    "anchors": {
      "$ref": "urn:feynman:common#/$defs/anchors"
    },
    "sources": {
      "$ref": "urn:feynman:common#/$defs/sources"
    }
  }
}
