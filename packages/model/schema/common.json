{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:feynman:common",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Readable kebab-case slug. Element ids are file names: actors/axod.json has id `axod`."
    },
    "ref": {
      "type": "string",
      "description": "The id of an element of the kind the field names (an actor for `actor`, a flow for `ref`, …)."
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "urn:feynman:common#/$defs/ref"
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "anchor": {
      "description": "Where an element lives in the repository at the modelled commit. Shorthand string: `path`, `path#symbol`, `path:10-42`, or `path:10:5-42:2` (1-based, inclusive). The object form says the same thing explicitly.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^#:]+(:[0-9]+(:[0-9]+)?(-[0-9]+(:[0-9]+)?)?)?(#.+)?$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Repository-relative file or directory path."
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "description": "Function, type, method, or table the anchor points at."
            },
            "span": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start"
              ],
              "properties": {
                "start": {
                  "$ref": "urn:feynman:common#/$defs/position"
                },
                "end": {
                  "$ref": "urn:feynman:common#/$defs/position"
                }
              },
              "description": "1-based, inclusive line (and optional column) range."
            }
          }
        }
      ]
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "urn:feynman:common#/$defs/anchor"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "repositoryFootprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Git pathspecs never counted (vendored code, lockfiles, …)."
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^(actors|flows|protocols|state|state-machines|invariants|claims|limits)/[a-z0-9][a-z0-9-]*$",
      "description": "Any element, named by its file path without `.json`: `flows/pi-recovery`, `protocols/pi-bridge`."
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
      },
      "description": "Written by tools, not agents: the content hash (git blob id, as `git hash-object` computes it) of every file this element anchors, as the file was on disk when the element was derived, committed or not. When any of these files changes, the element must be re-examined."
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "description": "The repository code of a component. `paths` are chosen by the extractor; `files` and `lines` are counted by `measure`.",
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "callNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "children"
      ],
      "description": "One call in a call tree, measured from the code (never written by hand). The root is the step's entry function; children are the calls it makes, at their call sites.",
      "properties": {
        "label": {
          "type": "string",
          "description": "The call as written, with the callee's parameters when it is defined in the repository: `loadModel(modelDir)`, `fs.readFileSync()`."
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Call site (the definition, for the root)."
        },
        "external": {
          "type": "boolean",
          "description": "The callee is not defined in the indexed code: a library, runtime, or system call."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/callNode"
          }
        }
      }
    }
  }
}
