{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:feynman:common",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Readable kebab-case slug. Element ids are file names: actors/axod.json has id `axod`."
    },
    "ref": {
      "type": "string",
      "description": "The id of an element of the kind the field names (an actor for `actor`, a flow for `ref`, …)."
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "urn:feynman:common#/$defs/ref"
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "anchor": {
      "description": "Where an element lives in the repository at the modelled commit. Shorthand string: `path`, `path#symbol`, `path:10-42`, or `path:10:5-42:2` (1-based, inclusive). The object form says the same thing explicitly.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^#:]+(:[0-9]+(:[0-9]+)?(-[0-9]+(:[0-9]+)?)?)?(#.+)?$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Repository-relative file or directory path."
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "description": "Function, type, method, or table the anchor points at."
            },
            "span": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start"
              ],
              "properties": {
                "start": {
                  "$ref": "urn:feynman:common#/$defs/position"
                },
                "end": {
                  "$ref": "urn:feynman:common#/$defs/position"
                }
              },
              "description": "1-based, inclusive line (and optional column) range."
            }
          }
        }
      ]
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "urn:feynman:common#/$defs/anchor"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "repositoryFootprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Git pathspecs never counted (vendored code, lockfiles, …)."
        }
      }
    },
    "actorFootprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "description": "The repository code that implements a first-party actor. `paths` are chosen by the extractor; `files` and `lines` are counted by tools/measure.mjs.",
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^(actors|flows|protocols|state|state-machines|invariants|claims|limits)/[a-z0-9][a-z0-9-]*$",
      "description": "Any element, named by its file path without `.json`: `flows/pi-recovery`, `protocols/pi-bridge`."
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
      },
      "description": "Written by tools, not agents: the git blob id (content hash) of every file this element anchors, at meta.source.commit. When any of these files changes, the element must be re-examined."
    }
  }
}
