{
  "name": "@leostera/feynman",
  "version": "0.15.0",
  "description": "Executable specs of how a system behaves: a simulator, a model checker, flows and their diffs, derived from one TypeScript file.",
  "type": "module",
  "homepage": "https://feynman.leostera.dev",
  "repository": { "type": "git", "url": "git+https://github.com/leostera/feynman.git", "directory": "packages/feynman" },
  "keywords": ["specification", "model-checking", "simulation", "distributed-systems", "pi-package"],
  "engines": { "bun": ">=1.3" },
  "bin": { "feynman": "bin/feynman.ts" },
  "exports": {
    ".": { "types": "./dist/types/spec/index.d.ts", "default": "./src/spec/index.ts" },
    "./play": { "types": "./dist/types/play/index.d.ts", "default": "./src/play/index.ts" },
    "./config": { "types": "./dist/types/cli/index.d.ts", "default": "./src/cli/index.ts" }
  },
  "files": ["bin", "src", "!src/view", "src/view/data.ts", "dist/view", "dist/types", "examples", "!examples/oracles", "skills", "README.md"],
  "pi": { "skills": ["./skills"] },
  "scripts": {
    "feynman": "bun bin/feynman.ts",
    "build": "vite build --config src/view/vite.config.ts && rm -rf dist/types && tsc -p tsconfig.types.json",
    "test": "bun test --timeout 60000",
    "oracles": "bun test ./test/examples/tla.oracle.ts ./test/examples/p.oracle.ts ./test/wild/wild.oracle.ts",
    "bench": "bun bench/suite.ts",
    "fuzz": "bun test/fuzz/run.ts",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "bun run build && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.15.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.3.0",
    "calldiff": "0.5.0",
    "react": "^19.3.1",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "*",
    "@types/node": "^24.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "elkjs": "^0.11.0",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
