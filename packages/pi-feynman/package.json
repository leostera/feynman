{
  "name": "@feynman/pi-feynman",
  "private": true,
  "type": "module",
  "description": "Pi adapter for Feynman: exposes @feynman/modeler as Pi tools, commands, and lifecycle hooks, and ships the modelling and rendering skills.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@feynman/modeler": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  }
}
