{
  "name": "@feynman/site",
  "private": true,
  "type": "module",
  "description": "feynman.leostera.dev: what Feynman is, and the simulators it has published.",
  "scripts": {
    "sim": "bun scripts/sim.ts",
    "dev": "bun scripts/pages.ts && cf dev",
    "build": "bun scripts/pages.ts && cf build",
    "deploy": "bun scripts/pages.ts && cf deploy",
    "typecheck": "tsc --noEmit && cf workers types && tsc --noEmit -p worker",
    "pages": "bun scripts/pages.ts"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.15.0",
    "@feynman/share": "workspace:*",
    "@leostera/feynman": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.24",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
