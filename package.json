{
  "name": "@leostera/feynman",
  "version": "0.8.0",
  "description": "Executable specs of how a system behaves: a simulator, a model checker, flows and their diffs, derived from one TypeScript file.",
  "type": "module",
  "homepage": "https://feynman.leostera.dev",
  "keywords": ["specification", "model-checking", "simulation", "distributed-systems", "pi-package"],
  "engines": { "bun": ">=1.3" },
  "bin": { "feynman": "bin/feynman.ts" },
  "exports": {
    ".": "./src/spec/index.ts",
    "./play": "./src/play/index.ts",
    "./config": "./src/cli/index.ts"
  },
  "files": ["bin", "src", "!src/view", "src/view/data.ts", "dist/view", "examples", "!examples/oracles", "skills", "README.md"],
  "pi": { "skills": ["./skills"] },
  "workspaces": ["sites/*", "packages/*"],
  "scripts": {
    "feynman": "bun bin/feynman.ts",
    "build": "vite build --config src/view/vite.config.ts",
    "test": "bun test --timeout 60000",
    "oracles": "bun test ./test/examples/tla.oracle.ts ./test/examples/p.oracle.ts ./test/wild/wild.oracle.ts",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "bun run build && bun run typecheck && bun run test",
    "site:deploy": "bun run --cwd sites/feynman.leostera.dev deploy"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.15.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.3.0",
    "calldiff": "0.5.0",
    "react": "^19.3.1",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "*",
    "@types/node": "^24.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "elkjs": "^0.11.0",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
