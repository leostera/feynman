{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feynman.dev/schemas/model.json",
  "title": "Feynman behavioural model",
  "description": "A model of a software system extracted from its code. Element `id`s are readable slugs for cross-references within one model; they are not stable across extractions. `anchors` locate an element in the code as `path` or `path#symbol`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "actors",
    "messages",
    "flows",
    "state",
    "invariants",
    "claims"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/messageSet"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "state": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "stateMachines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateMachine"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "observability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observability"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Readable kebab-case slug, unique within its collection."
    },
    "ref": {
      "type": "string",
      "description": "The id of another element in this model."
    },
    "anchor": {
      "description": "Where an element lives in the repository at the modelled commit. Shorthand string: `path`, `path#symbol`, `path:10-42`, or `path:10:5-42:2` (1-based, inclusive). The object form says the same thing explicitly.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^#:]+(:[0-9]+(:[0-9]+)?(-[0-9]+(:[0-9]+)?)?)?(#.+)?$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "description": "Repository-relative file or directory path."
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "description": "Function, type, method, or table the anchor points at."
            },
            "span": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/position"
                },
                "end": {
                  "$ref": "#/$defs/position"
                }
              },
              "description": "1-based, inclusive line (and optional column) range."
            }
          }
        }
      ]
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "summary",
        "source",
        "extraction"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "commit"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "url": {
              "type": "string",
              "description": "Browsable repository URL."
            },
            "commitUrl": {
              "type": "string",
              "description": "Browsable URL of the modelled commit."
            },
            "fileUrl": {
              "type": "string",
              "description": "Browsable URL template for a file at the modelled commit; `{path}` is replaced by an anchor path."
            },
            "committedAt": {
              "type": "string",
              "format": "date-time"
            },
            "main": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "commit",
                "ahead",
                "behind",
                "checkedAt"
              ],
              "description": "Position of the modelled commit relative to the main branch when last measured.",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "commit": {
                  "type": "string"
                },
                "ahead": {
                  "type": "integer",
                  "minimum": 0
                },
                "behind": {
                  "type": "integer",
                  "minimum": 0
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "footprint": {
              "$ref": "#/$defs/repositoryFootprint"
            }
          }
        },
        "extractedBy": {
          "type": "string"
        },
        "extraction": {
          "enum": [
            "bootstrap",
            "update"
          ]
        },
        "coverage": {
          "type": "string",
          "description": "What was and was not read in depth."
        },
        "extractedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provenance",
        "summary",
        "anchors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "provenance": {
          "enum": [
            "first-party",
            "third-party",
            "ambient"
          ],
          "description": "first-party: implemented in this repository. third-party: external software or service the system depends on. ambient: provided by the platform or environment the system runs in (OS services, the user's shell)."
        },
        "summary": {
          "type": "string"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "footprint": {
          "$ref": "#/$defs/actorFootprint"
        }
      }
    },
    "messageSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "transport",
        "anchors"
      ],
      "description": "The messages one actor accepts and emits over one transport.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/ref"
        },
        "transport": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "accepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "action"
      ],
      "description": "One semantic action in a flow, performed by `actor`, optionally directed at `target`.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/ref"
        },
        "action": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ref"
        },
        "ref": {
          "$ref": "#/$defs/ref",
          "description": "A sub-flow this step delegates to."
        },
        "boundary": {
          "$ref": "#/$defs/ref",
          "description": "A boundary this step crosses."
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Guarantees and conditions: transactional, idempotent, retried, bounded, under a lock, etc."
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "trigger",
        "steps",
        "anchors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "summary",
        "lifetime",
        "anchors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "owner": {
          "$ref": "#/$defs/ref"
        },
        "summary": {
          "type": "string"
        },
        "lifetime": {
          "type": "string"
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "anchors"
      ],
      "description": "Where untrusted or weakly structured data becomes trusted.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string"
        },
        "parsesInto": {
          "type": "string"
        },
        "effectsAfterParse": {
          "type": "boolean",
          "description": "True when no meaningful effect happens before parsing completes."
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "enforcedBy",
        "anchors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string"
        },
        "enforcedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Mechanisms, e.g. type, runtime, test, comment, design."
        },
        "consequence": {
          "type": "string",
          "description": "What happens if it breaks."
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchors"
      ],
      "description": "External behaviour that must stay stable, including compatibility layers.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string"
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchors"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string"
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "value",
        "kind",
        "anchors"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "kind": {
          "enum": [
            "limit",
            "size",
            "timeout",
            "interval",
            "rate",
            "count",
            "latency",
            "observed"
          ]
        },
        "anchors": {
          "$ref": "#/$defs/anchors"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "status",
        "epistemic",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "partially-supported",
            "contradicted",
            "unverified"
          ],
          "description": "How the evidence relates to the statement."
        },
        "epistemic": {
          "enum": [
            "stated",
            "inferred",
            "measured"
          ],
          "description": "stated: written in code, docs or tests; inferred: derived by reading code; measured: observed at runtime."
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/anchors"
        },
        "about": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "description": "Elements the claim is about (actors, flows, invariants, …)."
        }
      }
    },
    "repositoryFootprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Git pathspecs never counted (vendored code, lockfiles, …)."
        }
      }
    },
    "actorFootprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "description": "The repository code that implements a first-party actor. `paths` are chosen by the extractor; `files` and `lines` are counted by tools/measure.mjs.",
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
